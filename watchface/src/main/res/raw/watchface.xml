                        <Text align="CENTER">
                            <Font
                                color="#ffffff"
                                family="SYNC_TO_DEVICE"
                                size="24"
                                slant="NORMAL"
                                weight="NORMAL">
                                <Template>%s
                                    <Parameter expression="[COMPLICATION.TITLE]" />
                                </Template>
                            </Font>
