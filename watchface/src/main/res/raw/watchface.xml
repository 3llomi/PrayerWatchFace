                        height="50"
                        width="100"
                        x="0"
                        y="0">
                        <Variant
                            mode="AMBIENT"
                            target="alpha"
                            value="0" />
                        <Text align="CENTER">
                            <Font
                                color="[CONFIGURATION.themeColor.2]"
                                family="SYNC_TO_DEVICE"
                                size="24"
                                slant="NORMAL"
                                weight="NORMAL">
                                <Template>%s
