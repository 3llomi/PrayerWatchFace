                </Group>

                <Group
                    name="prayer-time"
                    height="50"
                    width="100"
                    x="245"
                    y="345">

                    <PartText
                        alpha="0"
                        height="50"
                        width="100"
                        x="0"
                        y="0">
                        <Variant
                            mode="AMBIENT"
                            target="alpha"
                            value="255" />
                        <Text align="CENTER">
                            <Font
                                color="#ffffff"
                                family="SYNC_TO_DEVICE"
                                size="24"
                                slant="NORMAL"
                                weight="NORMAL">
                                <Template>%s
                                    <Parameter expression="[COMPLICATION.TEXT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText
